{{- $hermes := lookPath "hermes" -}}
{{- if $hermes -}}
#!/bin/sh
set -eu

# 本文の変更で再実行される。Hermes 専用の英語ロールを使い、共有の日本語ロールは変更しない。
# 対象は chezmoi の配置先の既定プロファイル。呼出元の HERMES_HOME は引き継がない。
export HERMES_HOME={{ joinPath .chezmoi.destDir ".hermes" | quote }}

personality=$(cat <<'__HERMES_CUSTOM_ROLL__'
{{ dict "system_prompt" (include "private_dot_hermes/custom-roll/ereshkigal.md" | trimSuffix "\n") | toJson }}
__HERMES_CUSTOM_ROLL__
)

{{ $hermes | quote }} plugins enable plamo-translate
{{ $hermes | quote }} config set personalities.custom-roll "$personality" >/dev/null
{{ $hermes | quote }} config set display.personality custom-roll
{{- end }}
