[Unit]
Description=Run wallpaper services a bit after graphical session starts
PartOf=graphical-session.target
After=graphical-session.target

[Timer]
OnActiveSec=10s
Unit=wallpaper.target
# A target without StopWhenUnneeded=yes stays active, so a repeat timer never re-fires.
# OnUnitActiveSec=6h

[Install]
WantedBy=graphical-session.target
