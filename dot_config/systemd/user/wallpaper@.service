[Unit]
Description=mpvpaper for %i
PartOf=wallpaper.target
Requisite=graphical-session.target
After=graphical-session.target

[Service]
# VIDEO comes from ~/.config/wallpaper/<output>.env
EnvironmentFile=%h/.config/wallpaper/%i.env
ExecStart=/usr/bin/mpvpaper %i -o "--hwdec=auto --vd-lavc-dr=no --loop-file=inf --no-audio --cache=no --demuxer-max-bytes=32M --demuxer-max-back-bytes=16M --demuxer-readahead-secs=1" --auto-stop %h/Videos/wallpaper/${VIDEO}
Restart=on-failure
RestartSec=1
MemoryMax=1G
MemoryHigh=500M

[Install]
WantedBy=wallpaper.target
