// niri config for mac-intel-archlinux (MacBook Pro 2018 / A1989)
// 翻訳元: ~/.config/hypr/hyprland.conf (Lab-Arch)
// niri 26.04 向け。`niri validate` で検証すること。

input {
    keyboard {
        // 層5: locale1 (00-keyboard.conf) が壊れていてもここが効く。
        // このブロックが空だと niri は org.freedesktop.locale1 を見に行くので、
        // 意図的に明示している。
        xkb {
            layout "jp"
            model "jp106"
            options "ctrl:nocaps"
        }
        repeat-delay 200
        repeat-rate 35
    }

    // Hyprland: touchpad { natural_scroll = true }
    // accel-profile は指定しない (トラックパッドは adaptive のほうが快適)
    touchpad {
        tap
        dwt
        natural-scroll
    }

    // Hyprland: force_no_accel = true / accel_profile = flat / natural_scroll = true
    mouse {
        natural-scroll
        accel-profile "flat"
    }
}

// scale は推測値。初回起動後に `niri msg outputs` で実測して調整すること。
// mode は書かない: refresh rate は niri msg outputs の表示と小数3桁まで
// 一致していないと無効になるため、niri の自動選択に任せる。
output "eDP-1" {
    scale 2.0
}

// Hyprland: env = XCURSOR_SIZE,24 / HYPRCURSOR_SIZE,24
cursor {
    xcursor-size 24
}

// Hyprland: env = QT_QPA_PLATFORM,wayland;xcb
// fcitx5 系の環境変数は ~/.config/environment.d/fcitx5.conf 側で設定する
// (systemd user manager 経由のほうが XDG autostart と整合するため)。
environment {
    QT_QPA_PLATFORM "wayland;xcb"
}

layout {
    // Hyprland: gaps_out = 10 / gaps_in = 5 -> niri は単一の gaps
    gaps 10
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // Hyprland: border_size = 2 / col.active_border = rgba(33ccffee)
    // niri にグラデーションは無いので単色にする
    focus-ring {
        width 2
        active-color "#33ccff"
        inactive-color "#595959"
    }

    border {
        off
        width 2
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }
}

// Hyprland: exec-once = waybar (~/.config/waybar は既存)
spawn-at-startup "waybar"

// Hyprland: exec-once = /usr/lib/hyprpolkitagent -> mate-polkit に置換
spawn-at-startup "/usr/lib/mate-polkit/polkit-mate-authentication-agent-1"

// ロック/アイドル管理 (Hyprland: exec-once = hypridle の置き換え)。
// -w と swaylock -f の組み合わせは swayidle(1) の推奨。
// swayidle の lock イベントが logind の Lock シグナルを受けるので、
// loginctl lock-session でもロックがかかる。
// 初回起動では無効化 (swaylock の解錠が未検証のため)。
// 手動 swaylock で解錠を確認したら、この行頭の "// " を外して有効化する。
// spawn-sh-at-startup r#"swayidle -w timeout 300 'swaylock -f -c 000000' timeout 600 'niri msg action power-off-monitors' resume 'niri msg action power-on-monitors' before-sleep 'swaylock -f -c 000000' lock 'swaylock -f -c 000000'"#

// xwayland-satellite は niri 25.08 以降で組み込み管理されるため、
// spawn-at-startup も DISPLAY の手動設定も不要 (0.8.2 導入済み)。

// fcitx5 は spawn-at-startup しない。
// /etc/xdg/autostart/org.fcitx.Fcitx5.desktop を
// niri.service の Wants=xdg-desktop-autostart.target が拾う。

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
}

animations {
}

// Hyprland: decoration { rounding = 10 }
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Hyprland から翻訳したバインド ---
    Mod+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+T      hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+Ctrl+Return hotkey-overlay-title="Open a Terminal: kitty" { spawn "kitty"; }
    Mod+Space  hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Mod+F      hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+E      hotkey-overlay-title="Files: nautilus" { spawn "nautilus"; }
    Mod+Q repeat=false { close-window; }
    Mod+B { toggle-window-floating; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+M { quit; }
    // Hyprland の Mod+L はロックだが niri の hjkl と衝突するので Mod+Shift+L に移した。
    // loginctl lock-session -> logind の Lock シグナル -> swayidle の lock イベント
    // -> swaylock、という経路で効く。swayidle が動いていない場合に備えて
    // Mod+Ctrl+Shift+L で swaylock を直接起動するバインドも用意する。
    Mod+Shift+L      { spawn "loginctl" "lock-session"; }
    Mod+Ctrl+Shift+L { spawn "swaylock" "-f" "-c" "000000"; }

    // --- niri デフォルト (列モデル) ---
    Mod+D { spawn "fuzzel"; }
    Mod+O repeat=false { toggle-overview; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight     { focus-column-right; }
    Mod+WheelScrollLeft      { focus-column-left; }

    // --- ワークスペース (Hyprland: Mod+1..0 / Mod+Shift+1..0) ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // --- 列/ウィンドウ操作 ---
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+M { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+C { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }

    // --- スクリーンショット (niri 内蔵。grim+slurp の手組みは不要) ---
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }
    Mod+Shift+S { screenshot; }

    // --- メディアキー (Hyprland の bindel/bindl から翻訳) ---
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.2"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }

    // 画面輝度: i915 が intel_backlight の登録を skip するため acpi_video0 を明示する。
    // 初回起動後に `ls /sys/class/backlight/` で実在を確認すること。
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-d" "acpi_video0" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-d" "acpi_video0" "-e4" "-n2" "set" "5%-"; }

    // キーボードバックライト (MacBook 固有。journal で確認済みの LED 名)
    XF86KbdBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "-d" "apple::kbd_backlight" "set" "10%+"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-d" "apple::kbd_backlight" "set" "10%-"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P { power-off-monitors; }
}
