{
  "mcpServers": {
    "codex": {
      "command": "node",
      "args": ["{{ .chezmoi.homeDir }}/.claude/scripts/codex-mcp-bridge.mjs"]
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CONTEXT7_API_KEY}"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      }
    }
  }
}
