
{
  "colorScheme": "colorblind-friendly dark",
  "editor": "vim",
  "enableTerminalSandbox": true,
  "model": "Gemini 3.8 Flash (High)",
  "notifications": true,
  "showFeedbackSurvey": false,
  "statusLine": {
    "type": "command",
    "command": "~/.gemini/antigravity-cli/statusline.sh",
    "enabled": true,
    "stack_with_default": true
  },
  "permissions": {
    "deny": [
      "command(rm -rf .git)",
      "command(rm -r .git)",
      "command(rm -rf .git/*)",
      "command(rm -r .git/*)"
    ],
    "ask": [
      "command(pacman -S)"
    ],
    "allow": [
      "command(ls)",
      "command(cat)",
      "command(echo)",
      "command(pwd)",
      "command(tree)",
      "command(find)",
      "command(head)",
      "command(tail)",
      "command(wc)",
      "command(du)",
      "command(df)",
      "command(grep)",
      "command(rg)",
      "command(awk)",
      "command(xargs)",
      "command(chmod)",
      "command(read)",
      "command(python3)",
      "command(pytest)",
      "command(uv)",
      "command(npm)",
      "command(git)",
      "command(pacman -Q)",
      "command(apt search)",
      "command(.venv/bin/python3)",
      "command(.venv/bin/pip)",
      "command(bash ~/.agents/skills/agmsg/scripts/whoami.sh \"$PWD\" antigravity)",
      "command(bash ~/.agents/skills/agmsg/scripts/delivery.sh set turn antigravity \"$PWD\")",
      "command(bash ~/.agents/skills/agmsg/scripts/inbox.sh)"
    ]
  }
}
