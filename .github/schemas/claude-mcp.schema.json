{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["type"],
    "properties": {
      "type": { "type": "string", "enum": ["http", "sse", "stdio"] },
      "url": { "type": "string" },
      "headers": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      },
      "command": { "type": "string" },
      "args": { "type": "array", "items": { "type": "string" } },
      "env": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    }
  }
}
