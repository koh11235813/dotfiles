{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "mcp": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["local", "remote"] },
              "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "url": { "type": "string" },
              "headers": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "resource", "effect"],
        "properties": {
          "action": { "type": "string" },
          "resource": { "type": "string" },
          "effect": { "type": "string", "enum": ["allow", "ask", "deny"] }
        }
      }
    }
  }
}
