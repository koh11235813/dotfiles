{
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1"
  },
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "mcp__codex__codex",
      "mcp__codex__codex-reply",
      "mcp__gemini-cli__chat",
      "Skill(codex:setup)",
      "Skill(codex:rescue)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3:*)",
      "Bash(git ls-tree:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(.venv/bin/python3:*)",
      "Bash(.venv/bin/pip list:*)",
      "Bash(find:*)",
      "Bash(chmod:*)",
      "Bash(uv run python3:*)",
      "Bash(xargs -I {} sh -c 'echo \"\"=== {} ===\"\" && head -20 \"\"{}\"\"')",
      "Bash(xargs:*)",
      "Bash(PYTHONPATH=src:$PYTHONPATH uv run python3:*)",
      "Bash(PYTHONPATH=src:$PYTHONPATH uv run python3:*)",
      "Bash(rg:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(pytest *)",
      "Bash(read:*)",
      "Bash(awk *)",
      "Bash(pacman -Q:*)",
      "Bash(apt search *)"
    ],
    "ask": [
      "Bash(pacman -S:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/opus5.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/custom-roll.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/ng-check.py",
            "timeout": 10,
            "statusMessage": "NG表現チェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/ng-check.py",
            "timeout": 10,
            "statusMessage": "NG表現チェック中..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "agmsg@fujibee-agmsg": true,
    "eli5@claude-community": true,
    "thermos@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": "true"
    }
  },
  "outputStyle": "Concise",
  "language": "ツンデレ",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "claude-fable-5-1",
  "model": "claude-opus-5[1m]",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "defaultMode": "plan",
  "allowed_tools": [
    "npm",
    "ls",
    "cat",
    "echo",
    "git",
    "python3",
    "wc",
    "du",
    "df",
    "tail",
    "find",
    "head",
    "read"
  ]
}
