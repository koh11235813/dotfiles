{
  "cleanupPeriodDays": 1825,
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(wc:*)",
      "Skill(codex:setup)",
      "Skill(codex:rescue)",
      "Bash(git ls-tree:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(grep:*)",
      "Bash(.venv/bin/python3:*)",
      "Bash(.venv/bin/pip list:*)",
      "Bash(find:*)",
      "Bash(uv run python3:*)",
      "Bash(xargs -I {} sh -c 'echo \"\"=== {} ===\"\" && head -20 \"\"{}\"\"')",
      "Bash(PYTHONPATH=src:$PYTHONPATH uv run python3:*)",
      "Bash(rg:*)",
      "Bash(uv sync:*)",
      "Bash(uv run:*)",
      "Bash(pytest *)",
      "Bash(read:*)",
      "Bash(awk *)",
      "Bash(pacman -Q:*)",
      "Bash(apt search *)"
    ],
    "ask": [
      "Bash(pacman -S:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-5-5[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/prompt-by-model.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/custom-roll.sh"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/model-state.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/ng-check.py",
            "timeout": 10,
            "statusMessage": "NG表現チェック中..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/ng-check.py",
            "timeout": 10,
            "statusMessage": "NG表現チェック中..."
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/model-state.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/model-state-cleanup.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/scripts/statusline-command.sh"
  },
  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "discord@claude-plugins-official": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "exa@claude-plugins-official": true,
    "agmsg@fujibee-agmsg": true,
    "eli5@claude-community": true,
    "thermos@cursor-plugins": true,
    "typesafe@typesafe-ai": true,
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      },
      "autoUpdate": true
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      },
      "autoUpdate": true
    },
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins"
      },
      "autoUpdate": true
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      },
      "autoUpdate": true
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "koh11235813/i-have-adhd"
      },
      "autoUpdate": true
    }
  },
  "language": "Japanese",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "claude-fable-5-1",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "timeFormat": "auto",
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": true,
  "switchModelsOnFlag": false,
  "autoContinueAtUsageLimit": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — no git remotes configured for this repo, and gh lookup was not queryable (no origin remote to derive org/repo from)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured) — this repo currently has no remotes configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: The git repository the agent started in (/Users/kinoko/Development/github) — it currently has no tracked files and no remotes configured",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
